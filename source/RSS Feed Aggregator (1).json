      "parameters": {
        "functionCode": "const seen = new Set();\nconst unique = items.filter(item => {\n  if (seen.has(item.json.link)) return false;\n  seen.add(item.json.link);\n  return true;\n});\n\nreturn unique.sort((a, b) => {\n  return new Date(b.json.date) - new Date(a.json.date);\n});"
